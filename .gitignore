.secrets.env
node_modules/
dist/
.next/
out/
*.tsbuildinfo
.DS_Store

# large assets never committed
packages/ntsim-assets/data/dumps/*
packages/ntsim-assets/data/*.bin
!packages/ntsim-assets/data/.gitkeep
apps/web/public/assets/*.bin

# v86 guest image + buildroot tree are build artifacts (see packages/v86-lab/vendor/README.md)
packages/v86-lab/build/
packages/v86-lab/artifacts/
packages/v86-lab/vendor/artifacts/
apps/web/public/vendor/artifacts/

# ghidra decompiler wasm (pyre pipeline output — rebuild via `npm run vendor:ghidra`,
# see packages/ghidra-decompiler/vendor/README.md; the shim itself IS committed)
apps/web/public/vendor/ghidra/

# tmpout research cache (scrape via `node tools/scrape-tmpout.mjs`)
.cache/
.secrets.env
